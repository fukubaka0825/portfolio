---
import { feedHomes, getFeedItems } from '~/lib/feeds'
import { formatDate } from '~/lib/format'

const LIMIT = 12
// getFeedItems already sorts newest-first and nothing is cut here, so the media filter can reveal older posts the "all" view pushes below the fold.
const items = await getFeedItems()
const sources: string[] = [...new Set(items.map((i) => i.source))]
// Same order as the filter chips; a source with no items right now (feed failed) falls to the end instead of vanishing.
const rank = (name: string) => (sources.includes(name) ? sources.indexOf(name) : sources.length)
const homes = Object.entries(feedHomes).sort(([a], [b]) => rank(a) - rank(b))
---

<section id="writing" class="bg-paper pb-24 sm:pb-32">
  <div class="wrap">
    <h2 class="display text-[clamp(3.2rem,9vw,8rem)] font-extrabold">Writing</h2>

    <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="媒体で絞り込む" data-filter>
      <button type="button" aria-pressed="true" data-source="all" class="chip">すべて</button>
      {
        sources.map((s) => (
          <button type="button" aria-pressed="false" data-source={s} class="chip">
            {s}
          </button>
        ))
      }
    </div>

    <ol class="mt-8 grid gap-x-10 md:grid-cols-2" data-feed>
      {
        items.map((item, i) => (
          <li class="border-t border-line" data-item data-source={item.source} hidden={i >= LIMIT}>
            <a
              href={item.url}
              target="_blank"
              rel="noopener"
              class="group flex flex-col gap-1 py-4"
            >
              <span class="flex gap-3 text-[0.82rem] text-mist tnum">
                <time datetime={item.date}>{formatDate(item.date)}</time>
                <span class="font-semibold text-hoodie-deep">{item.source}</span>
              </span>
              <span class="text-[1.05rem] leading-snug font-semibold decoration-hoodie decoration-2 underline-offset-4 group-hover:underline">
                {item.title}
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <button
      type="button"
      class="mt-6 rounded-full border-2 border-ink px-5 py-2 text-[0.92rem] font-semibold transition-colors duration-300 hover:bg-ink hover:text-yolk"
      hidden={items.length <= LIMIT}
      data-more
    >
      もっと見る
    </button>

    <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-[0.95rem]">
      {
        homes.map(([name, href]) => (
          <li>
            <a href={href} target="_blank" rel="noopener" class="text-ink/75 underline decoration-line decoration-2 hover:decoration-hoodie">
              {name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .chip {
    border-radius: 9999px;
    border: 2px solid var(--color-ink);
    padding: 0.3rem 0.9rem;
    font-size: 0.88rem;
    font-weight: 600;
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  .chip[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-yolk);
  }
</style>

<script>
  import { gsap, reducedMotion } from '~/scripts/motion'

  const LIMIT = 12
  const group = document.querySelector<HTMLElement>('[data-filter]')
  const more = document.querySelector<HTMLButtonElement>('[data-more]')
  const items = [...document.querySelectorAll<HTMLElement>('[data-item]')]
  let source = 'all'
  let expanded = false

  const render = (animateFrom = 0) => {
    const matches = items.filter((it) => source === 'all' || it.dataset.source === source)
    const cap = expanded ? matches.length : LIMIT
    for (const it of items) it.hidden = true
    const visible = matches.slice(0, cap)
    for (const it of visible) it.hidden = false
    if (more) more.hidden = matches.length <= cap
    const entering = visible.slice(animateFrom)
    if (!reducedMotion() && entering.length)
      gsap.fromTo(entering, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.5, stagger: 0.03, ease: 'power3' })
  }

  group?.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('button[data-source]')
    if (!btn) return
    for (const b of group.querySelectorAll('button')) b.setAttribute('aria-pressed', String(b === btn))
    source = btn.dataset.source ?? 'all'
    expanded = false
    render()
  })

  more?.addEventListener('click', () => {
    const before = items.filter((it) => !it.hidden).length
    expanded = true
    render(before)
    // Keep keyboard users in place: focus the first newly revealed item instead of leaving it on a vanished button.
    items.filter((it) => !it.hidden)[before]?.querySelector('a')?.focus()
  })
</script>
